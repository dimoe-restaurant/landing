# Resend — https://resend.com → API Keys → Create API Key
# Free tier: 100 emails/día, sin tarjeta de crédito
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Maps embed (opcional — ya hay default hardcodeado)
NEXT_PUBLIC_MAPS_EMBED_SRC=

# Google Business Profile URL para reseñas
NEXT_PUBLIC_GOOGLE_MAPS_URL=

# URL del PDF de carta (Canva u otro)
NEXT_PUBLIC_MENU_PDF_URL=

# Instagram Graph API — System User token (Meta Business Manager)
INSTAGRAM_ACCESS_TOKEN=

# Analytics (configurar cuando estén disponibles los IDs)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXXXX

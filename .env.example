# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXXXX

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_URL=https://maps.app.goo.gl/...
NEXT_PUBLIC_MAPS_EMBED_SRC=

# Carta PDF (Canva u otro)
NEXT_PUBLIC_MENU_PDF_URL=

# Email (Resend) — resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Places API (reseñas) — Google Cloud Console
GOOGLE_PLACES_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Instagram Graph API — System User token (Meta Business Manager)
INSTAGRAM_ACCESS_TOKEN=

# Notion (Integration Token + DB IDs)
# Token: notion.so/profile/integrations → DiMOE integration
# DB IDs: abrir cada DB en Notion → copiar UUID de la URL
NOTION_ACCESS_TOKEN=secret_xxx
NOTION_DB_CONTACTOS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DB_MENU=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NOTION_DRY_RUN=1    — omite escrituras a Notion en local

# On-demand revalidation (/api/revalidate?secret=...&tag=menu)
REVALIDATE_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Rate limiting (Upstash Redis) — upstash.com → Redis DB → REST API
# Sin estas vars, checkRateLimit() falla abierto (permite todo) — no bloquea local sin configurar.
UPSTASH_REDIS_REST_URL=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Captcha invisible (Cloudflare Turnstile) — dash.cloudflare.com → Turnstile → Add site
# Sin TURNSTILE_SECRET_KEY, /api/contact deja pasar el envío sin validar el captcha (no bloquea local sin configurar).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxxx

NOTION_DB_CONTACTOS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DB_MENU=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NOTION_DRY_RUN=1    — omite escrituras a Notion en local

# On-demand revalidation (/api/revalidate?secret=...&tag=menu)
REVALIDATE_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
